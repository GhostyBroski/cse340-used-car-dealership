<%- include('../../partials/head') %>
<%- include('../../partials/header') %>
<main class="admin-container">
    <div class="admin-header">
        <h1><%= title %></h1>
    </div>

    <div class="vehicle-edit-wrapper">
        <!-- Vehicle Information Card -->
        <div class="vehicle-info-card">
            <h2>Vehicle Details (Read-Only)</h2>
            <div class="info-grid">
                <div class="info-item">
                    <span class="label">Make:</span>
                    <span class="value"><%= vehicle.make %></span>
                </div>
                <div class="info-item">
                    <span class="label">Model:</span>
                    <span class="value"><%= vehicle.model %></span>
                </div>
                <div class="info-item">
                    <span class="label">Year:</span>
                    <span class="value"><%= vehicle.year %></span>
                </div>
                <div class="info-item">
                    <span class="label">VIN:</span>
                    <span class="value"><%= vehicle.vin %></span>
                </div>
                <div class="info-item">
                    <span class="label">Color:</span>
                    <span class="value"><%= vehicle.color %></span>
                </div>
                <div class="info-item">
                    <span class="label">Mileage:</span>
                    <span class="value"><%= vehicle.mileage.toLocaleString() %> miles</span>
                </div>
            </div>
        </div>

        <!-- Editable Fields Form -->
        <form method="POST" action="/admin/vehicles/<%= vehicle.id %>" class="admin-form">
            <h2>Edit Vehicle Information</h2>

            <div class="form-group">
                <label for="price">Price *</label>
                <input 
                    type="number" 
                    id="price" 
                    name="price" 
                    value="<%= vehicle.price %>"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                    required>
                <small>Enter the selling price</small>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea 
                    id="description" 
                    name="description" 
                    maxlength="2000"
                    rows="6"
                    placeholder="Enter vehicle description..."><%= vehicle.description || '' %></textarea>
                <small>Description of vehicle condition, features, and history (max 2000 characters)</small>
            </div>

            <div class="form-group">
                <label for="availability">Availability</label>
                <select id="availability" name="availability">
                    <option value="true" <%= vehicle.availability ? 'selected' : '' %>>Available for Sale</option>
                    <option value="false" <%= !vehicle.availability ? 'selected' : '' %>>Unavailable (Sold or Hold)</option>
                </select>
                <small>Set whether this vehicle is available for purchase</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Vehicle</button>
                <a href="/admin/vehicles" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

        <!-- View on Catalog -->
        <div class="view-button" style="text-align: center; margin-top: 2rem;">
            <a href="/catalog/vehicles/<%= vehicle.id %>" class="btn btn-link">View on Catalog</a>
        </div>
    </div>
</main>

<style>
.vehicle-edit-wrapper {
    max-width: 700px;
    margin: 0 auto;
}

.vehicle-info-card {
    background: #f9f9f9;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
}

.vehicle-info-card h2 {
    margin-top: 0;
    color: #333;
    font-size: 1.3rem;
    border-bottom: 2px solid #2c5aa0;
    padding-bottom: 1rem;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.info-item {
    display: flex;
    flex-direction: column;
}

.info-item .label {
    font-weight: 600;
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
}

.info-item .value {
    color: #333;
    font-size: 1rem;
    padding: 0.5rem;
    background: white;
    border-radius: 4px;
}

.admin-form {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
}

.admin-form h2 {
    margin-top: 0;
    color: #333;
    font-size: 1.3rem;
    border-bottom: 2px solid #2c5aa0;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
}

.btn-link {
    background: transparent;
    color: #2c5aa0;
    text-decoration: underline;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 1rem;
}

.btn-link:hover {
    color: #1a3a6b;
}

@media (max-width: 768px) {
    .info-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<%- include('../../partials/footer') %>
