<%- include('../../partials/head') %>
<%- include('../../partials/header') %>
<main class="admin-container">
    <div class="admin-header">
        <h1>System Activity</h1>
    </div>

    <div class="admin-info">
        <p><strong>System Overview</strong></p>
        <p>View system statistics and administrative information.</p>
    </div>

    <div class="activity-stats">
        <div class="stat-card">
            <h3>Total Users</h3>
            <p class="stat-number"><%= stats.totalUsers || 0 %></p>
        </div>
        <div class="stat-card">
            <h3>Active Employees</h3>
            <p class="stat-number"><%= stats.employeeCount || 0 %></p>
        </div>
        <div class="stat-card">
            <h3>Total Vehicles</h3>
            <p class="stat-number"><%= stats.totalVehicles || 0 %></p>
        </div>
        <div class="stat-card">
            <h3>Categories</h3>
            <p class="stat-number"><%= stats.totalCategories || 0 %></p>
        </div>
        <div class="stat-card">
            <h3>Service Requests</h3>
            <p class="stat-number"><%= stats.totalRequests || 0 %></p>
        </div>
        <div class="stat-card">
            <h3>Reviews</h3>
            <p class="stat-number"><%= stats.totalReviews || 0 %></p>
        </div>
    </div>

    <div class="activity-section">
        <h2>System Information</h2>
        <div class="info-box">
            <p><strong>Environment:</strong> <%= NODE_ENV %></p>
            <p><strong>Current Date:</strong> <%= new Date().toLocaleDateString() %></p>
            <p><strong>Current Time:</strong> <%= new Date().toLocaleTimeString() %></p>
        </div>
    </div>

    <div class="activity-section">
        <h2>Quick Actions</h2>
        <div class="action-links">
            <a href="/admin/users" class="btn btn-primary">Manage Users</a>
            <a href="/admin/categories" class="btn btn-primary">Manage Categories</a>
            <a href="/admin/vehicles" class="btn btn-primary">Manage Vehicles</a>
            <a href="/requests/list" class="btn btn-primary">View Service Requests</a>
        </div>
    </div>
</main>

<style>
.activity-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
}

.stat-card {
    background: white;
    border: 2px solid #2c5aa0;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
}

.stat-card h3 {
    margin: 0 0 1rem 0;
    color: #333;
    font-size: 1rem;
}

.stat-number {
    margin: 0;
    font-size: 2.5rem;
    font-weight: bold;
    color: #2c5aa0;
}

.activity-section {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
}

.activity-section h2 {
    margin-top: 0;
    color: #333;
    border-bottom: 2px solid #2c5aa0;
    padding-bottom: 1rem;
}

.info-box {
    background: #f9f9f9;
    padding: 1rem;
    border-radius: 6px;
    border-left: 4px solid #2c5aa0;
}

.info-box p {
    margin: 0.5rem 0;
    color: #555;
}

.action-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

.action-links .btn {
    text-align: center;
    padding: 1rem;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.action-links .btn-primary {
    background: #2c5aa0;
    color: white;
}

.action-links .btn-primary:hover {
    background: #1a3a6b;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(44, 90, 160, 0.3);
}
</style>

<%- include('../../partials/footer') %>
