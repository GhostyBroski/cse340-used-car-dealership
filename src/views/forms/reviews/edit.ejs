<%- include('../../partials/head') %>
<%- include('../../partials/header') %>
<main class="review-edit-container">
    <h1><%= title %></h1>
    
    <form action="/vehicles/<%= vehicleId %>/reviews/<%= review.id %>" method="POST" class="review-form">
        <div class="form-group">
            <label for="rating">Rating:</label>
            <select id="rating" name="rating" required>
                <option value="">-- Select a rating --</option>
                <option value="5" <%= review.rating === 5 ? 'selected' : '' %>>5 Stars - Excellent</option>
                <option value="4" <%= review.rating === 4 ? 'selected' : '' %>>4 Stars - Good</option>
                <option value="3" <%= review.rating === 3 ? 'selected' : '' %>>3 Stars - Average</option>
                <option value="2" <%= review.rating === 2 ? 'selected' : '' %>>2 Stars - Fair</option>
                <option value="1" <%= review.rating === 1 ? 'selected' : '' %>>1 Star - Poor</option>
            </select>
        </div>

        <div class="form-group">
            <label for="comment">Your Review:</label>
            <textarea id="comment" name="comment" rows="5" required><%= review.comment %></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Update Review</button>
        <a href="/vehicles/<%= vehicleId %>/reviews" class="btn btn-secondary">Cancel</a>
    </form>
</main>
<%- include('../../partials/footer') %>